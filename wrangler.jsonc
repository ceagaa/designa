{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dirigentes",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2026-10-21",
  "vars": {
    // Client ID público do OAuth do Google. Mesmo valor do VITE_GOOGLE_CLIENT_ID
    // no .env: o Worker usa para conferir o `aud` do ID token do login com Google.
    "GOOGLE_CLIENT_ID": "328567818313-gdcglqclpen5cg8nf37d47c0ur0ml8t6.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/escala/*", "/tpl/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dirigentes",
      "database_id": "dfd03273-9cd5-4fe3-888d-3444d30bc175",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
