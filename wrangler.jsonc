{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dirigentes",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dirigentes",
      "database_id": "dfd03273-9cd5-4fe3-888d-3444d30bc175"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
